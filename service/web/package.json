{
  "name": "ac-web-workspace",
  "private": true,
  "workspaces": [
    "shared",
    "customer",
    "partner",
    "technician",
    "admin"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present && eslint --max-warnings=0 -c e2e/eslint.config.mjs e2e && eslint --max-warnings=0 -c load/eslint.config.mjs load",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present && tsc -p e2e/tsconfig.json && tsc -p load/tsconfig.json",
    "e2e": "playwright test -c e2e/playwright.config.ts",
    "knip": "knip --no-progress"
  },
  "devDependencies": {
    "@eslint-community/eslint-plugin-eslint-comments": "4.8.1",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.0",
    "@tailwindcss/postcss": "^4.3.5",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/k6": "2.3.1",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "@vitest/eslint-plugin": "1.6.28",
    "axe-core": "4.14.0",
    "eslint": "^10.14.0",
    "eslint-config-next": "^16.4.5",
    "eslint-plugin-playwright": "2.12.2",
    "eslint-plugin-security": "4.2.1",
    "eslint-plugin-sonarjs": "4.2.2",
    "eslint-plugin-unicorn": "79.0.0",
    "globals": "17.14.0",
    "jsdom": "^31.0.0",
    "jsqr": "1.4.0",
    "knip": "6.44.1",
    "shadcn": "4.23.0",
    "tailwindcss": "^4.1.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "8.72.1",
    "vitest": "^5.1.0",
    "zod": "4.6.7"
  },
  "engines": {
    "node": ">=26.0.0"
  }
}
