        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kontrak ini sudah memiliki faktur untuk sebagian periode ini — pilih periode setelahnya"
          }
        }
      }
    },
    "This contractor has jobs, offers, certificates, payouts or users, so it cannot be deleted": {
      "extractionState": "manual",
      "localizations": {
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Kontraktor ini mempunyai kerja, tawaran, sijil, bayaran atau pengguna, jadi tidak boleh dipadam"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この契約会社には案件・オファー・証明書・支払い・ユーザーがあるため削除できません"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kontraktor ini memiliki pekerjaan, penawaran, sertifikat, pencairan, atau pengguna, jadi tidak dapat dihapus"
          }
        }
      }
    },
    "This customer has jobs, contracts, invoices, reports or users, so it cannot be deleted": {
