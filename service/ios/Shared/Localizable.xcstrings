    "Location automations cannot run until you grant it again. Manual control and schedules are unaffected.": {
      "extractionState": "manual",
      "localizations": {
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Automasi lokasi tidak boleh berjalan sehingga anda memberikannya semula. Kawalan manual dan jadual tidak terjejas."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "もう一度同意するまで、位置情報の自動化は動きません。手動操作とスケジュールには影響しません。"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Otomasi lokasi tidak dapat berjalan sampai Anda memberikannya lagi. Kontrol manual dan jadwal tidak terpengaruh."
          }
        }
      }
    },
    "Location automations need your consent. It is used only for arrival/departure automations: your device’s location is compared with the map pins of your homes and offices, and only home or away is kept.": {
      "extractionState": "manual",
      "localizations": {
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Automasi lokasi memerlukan persetujuan anda. Ia digunakan hanya untuk automasi tiba/keluar: lokasi peranti anda dibandingkan dengan pin peta rumah dan pejabat anda, dan hanya di rumah atau keluar disimpan."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "位置オートメーションにはあなたの同意が必要です。到着/外出のオートメーションにだけ使います。端末の位置を自宅やオフィスの地図ピンと比べ、保存するのは在宅か外出かだけです。"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Otomatisasi lokasi memerlukan persetujuan Anda. Ini hanya dipakai untuk otomatisasi tiba/pergi: lokasi perangkat Anda dibandingkan dengan pin peta rumah dan kantor Anda, dan hanya di rumah atau pergi yang disimpan."
          }
        }
      }
    },
    "Location consent — for arrival/departure automations only": {
      "extractionState": "manual",
      "localizations": {
        "ms": {
          "stringUnit": {
