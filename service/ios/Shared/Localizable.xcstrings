    "At least one active membership must keep “Edit users & roles” — give it to another HQ membership first, then change this one": {
      "extractionState": "manual",
      "localizations": {
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Sekurang-kurangnya satu keahlian aktif mesti mengekalkan “Edit pengguna & peranan” — berikannya kepada keahlian HQ lain dahulu, kemudian ubah yang ini"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "有効なメンバーシップのうち少なくとも1つは「ユーザーと役割の編集」を持つ必要があります — 先に別の本部のメンバーシップに付与してから、これを変更してください"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Setidaknya satu keanggotaan aktif harus mempertahankan “Ubah pengguna & peran” — berikan kepada keanggotaan HQ lain lebih dulu, lalu ubah yang ini"
          }
        }
      }
    },
