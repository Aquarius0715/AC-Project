    },
    "{field} belongs to someone who still has access — use another address or ask HQ": {
      "extractionState": "manual",
      "localizations": {
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "{field} milik seseorang yang masih mempunyai akses — gunakan alamat lain atau tanya ibu pejabat"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "{field} は、まだアクセス権を持つ人のものです — 別のアドレスを使うか、本部にご相談ください"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "{field} milik seseorang yang masih memiliki akses — gunakan alamat lain atau tanyakan HQ"
          }
        }
      }
    },
    "{field} has the wrong number of entries": {
      "extractionState": "manual",
      "localizations": {
