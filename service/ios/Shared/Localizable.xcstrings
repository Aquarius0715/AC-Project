        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "AC ini berubah — muat ulang dan coba lagi"
          }
        }
      }
    },
    "This AC is offline. Remote actions are disabled until the connection returns. Last seen {when}.": {
      "extractionState": "manual",
      "localizations": {
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "AC ini di luar talian. Tindakan jauh dilumpuhkan sehingga sambungan pulih. Kali terakhir dilihat {when}."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このエアコンはオフラインです。接続が戻るまで、遠隔操作はできません。最後の通信: {when}。"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "AC ini offline. Tindakan jarak jauh dinonaktifkan sampai koneksi kembali. Terakhir terlihat {when}."
          }
        }
      }
    },
    "This AC’s module only measures: its readings are shown below, and settings are changed on the AC itself.": {
      "extractionState": "manual",
      "localizations": {
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Modul AC ini hanya mengukur: bacaannya ditunjukkan di bawah, dan tetapan ditukar pada AC itu sendiri."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このエアコンのモジュールは測定のみを行います。測定値は下に表示され、設定はエアコン本体で変更します。"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Modul AC ini hanya mengukur: hasil bacaannya ditampilkan di bawah, dan pengaturan diubah langsung pada AC."
          }
        }
      }
    },
    "This account has acted or has an assignment or certificate, so it cannot be deleted — revoke the access instead": {
      "extractionState": "manual",
      "localizations": {
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Akaun ini pernah bertindak atau mempunyai tugasan atau sijil, jadi tidak boleh dipadam — batalkan akses sebaliknya"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このアカウントは操作の履歴、割り当て、または証明書があるため削除できません。代わりにアクセスを取り消してください"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Akun ini pernah bertindak atau memiliki penugasan atau sertifikat, jadi tidak dapat dihapus — cabut aksesnya saja"
          }
        }
      }
    },
    "This account is not for this app — sign in with another account": {
      "extractionState": "manual",
      "localizations": {
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Akaun ini bukan untuk aplikasi ini — log masuk dengan akaun lain"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
