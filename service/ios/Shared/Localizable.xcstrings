    "A capability for this manufacturer and model exists already": {
      "extractionState": "manual",
      "localizations": {
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Keupayaan untuk pengeluar dan model ini sudah wujud"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このメーカーと型番の機能定義はすでにあります"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kemampuan untuk pabrikan dan model ini sudah ada"
          }
        }
      }
    },
    "A firmware campaign names this model, so it cannot be deleted": {
      "extractionState": "manual",
      "localizations": {
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Kempen perisian tegar menamakan model ini, jadi ia tidak boleh dipadam"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ファームウェア配信にこのモデルの名前があるため、削除できません"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kampanye firmware menyebut model ini, jadi tidak dapat dihapus"
          }
        }
      }
    },
    "A payment of a cause invoice is in progress — wait for it to be confirmed or to fail": {
      "extractionState": "manual",
      "localizations": {
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Pembayaran bagi invois punca sedang berjalan — tunggu sehingga ia disahkan atau gagal"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "原因となった請求書の支払いが処理中です — 確定するか失敗するまでお待ちください"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pembayaran faktur penyebab sedang berlangsung — tunggu sampai dikonfirmasi atau gagal"
          }
        }
      }
    },
    "Accepted": {
      "extractionState": "manual",
      "localizations": {
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Diterima"
          }
