    "The visit time was agreed with the client; accept it or say you can’t make it.": {
      "extractionState": "manual",
      "localizations": {
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Masa lawatan telah dipersetujui dengan pelanggan; terimanya atau nyatakan anda tidak dapat hadir."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "訪問時刻は顧客と合意済みです。承諾するか、対応できないと回答してください。"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Waktu kunjungan disepakati dengan klien; terima atau katakan Anda tidak bisa hadir."
          }
        }
      }
    },
    "The visit times were agreed with the client.": {
      "extractionState": "manual",
      "localizations": {
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Masa lawatan telah dipersetujui dengan pelanggan."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "訪問時刻は顧客と合意済みです。"
