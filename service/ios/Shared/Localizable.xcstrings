    "A firmware campaign names this model, so it cannot be deleted": {
      "extractionState": "manual",
      "localizations": {
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Kempen perisian tegar menamakan model ini, jadi ia tidak boleh dipadam"
