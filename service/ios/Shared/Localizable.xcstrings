        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kampanye ini belum berakhir — batalkan lebih dulu"
          }
        }
      }
    },
    "This clashes with another record, or with a change made at the same moment — reload the page and try again": {
      "extractionState": "manual",
      "localizations": {
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Ini bertembung dengan rekod lain, atau dengan perubahan yang dibuat pada masa yang sama — muat semula halaman dan cuba lagi"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "別の記録、または同時に行われた変更と重なりました。ページを再読み込みしてもう一度お試しください"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ini bertabrakan dengan catatan lain, atau dengan perubahan yang dilakukan pada saat yang sama — muat ulang halaman dan coba lagi"
          }
        }
      }
    },
    "This contract already has an invoice for part of this period — choose a period after it": {
      "extractionState": "manual",
      "localizations": {
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Kontrak ini sudah mempunyai invois bagi sebahagian tempoh ini — pilih tempoh selepasnya"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
