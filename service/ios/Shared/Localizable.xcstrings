    "On hold by HQ — saving and submitting are blocked. Your saved draft is kept; continue when HQ resumes the job.": {
      "extractionState": "manual",
      "localizations": {
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Ditangguhkan oleh HQ — menyimpan dan menghantar disekat. Draf yang disimpan dikekalkan; teruskan apabila HQ menyambung semula kerja."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "本部が保留中です — 保存と提出はできません。保存済みの下書きは残ります。本部が作業を再開したら続けてください。"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ditahan oleh HQ — menyimpan dan menyerahkan diblokir. Draf tersimpan Anda dipertahankan; lanjutkan saat HQ melanjutkan pekerjaan."
          }
        }
      }
    },
    "On site: Start job opens Check in (location + unit QR); checking in starts the work.": {
      "extractionState": "manual",
      "localizations": {
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Di tapak: Mulakan kerja membuka Daftar masuk (lokasi + QR unit); daftar masuk memulakan kerja."
          }
        },
        "ja": {
          "stringUnit": {
