    },
    "This unit is still in use — a current contract, an open job, a bound device, a restriction, or a command or check still running — end or remove them before archiving": {
      "extractionState": "manual",
      "localizations": {
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Unit ini masih digunakan — kontrak semasa, kerja terbuka, peranti terikat, sekatan, atau arahan atau semakan yang masih berjalan — tamatkan atau alihkannya sebelum mengarkib"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このユニットはまだ使われています（有効な契約、未完了の作業、紐付いたデバイス、制限、実行中の操作や診断）。アーカイブする前に終了または解除してください"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Unit ini masih digunakan — kontrak berjalan, pekerjaan terbuka, perangkat terikat, pembatasan, atau perintah atau pemeriksaan yang masih berjalan — akhiri atau hapus sebelum mengarsipkan"
