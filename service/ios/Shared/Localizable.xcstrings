      "localizations": {
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Pelanggan ini mempunyai kerja, kontrak, invois, laporan atau pengguna, jadi tidak boleh dipadam"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このお客様には案件・契約・請求・レポート・ユーザーがあるため削除できません"
