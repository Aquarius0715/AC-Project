    "Another operation is running on this unit — try again when it has finished": {
      "extractionState": "manual",
      "localizations": {
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Operasi lain sedang berjalan pada unit ini — cuba lagi apabila ia selesai"
