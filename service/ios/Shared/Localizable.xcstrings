    "Allow location “Always” so that arriving and leaving are reported while the app is closed.": {
      "extractionState": "manual",
      "localizations": {
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Benarkan lokasi “Sentiasa” supaya ketibaan dan keluar dilaporkan semasa aplikasi ditutup."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アプリを閉じている間も到着と出発を報告するには、位置情報を「常に」許可してください。"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Izinkan lokasi “Selalu” agar tiba dan pergi dilaporkan saat aplikasi ditutup."
          }
        }
      }
    },
