    "Arrival inside the window counts toward the SLA. Times are part of the report and visible to the contractor and HQ.": {
      "extractionState": "manual",
      "localizations": {
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Ketibaan dalam tetingkap dikira untuk SLA. Masa adalah sebahagian daripada laporan dan boleh dilihat oleh kontraktor dan HQ."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "作業時間内の到着は SLA の対象になります。時刻は報告書の一部で、協力会社と本部に表示されます。"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kedatangan di dalam jendela dihitung untuk SLA. Waktu menjadi bagian laporan dan terlihat oleh kontraktor dan HQ."
          }
        }
      }
    },
    "Arrival must be inside your work window. Checking in records the arrival and starts the work.": {
      "extractionState": "manual",
      "localizations": {
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Ketibaan mesti dalam tetingkap kerja anda. Daftar masuk merekodkan ketibaan dan memulakan kerja."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "到着は作業時間内である必要があります。チェックインすると、到着が記録され、作業が始まります。"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kedatangan harus di dalam jendela pekerjaan Anda. Check-in mencatat kedatangan dan memulai pekerjaan."
          }
        }
      }
    },
