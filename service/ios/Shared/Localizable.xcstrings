        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Akun ini bukan untuk aplikasi ini — masuk dengan akun lain"
          }
        }
      }
    },
    "This account’s access period has ended — set a new access end first": {
      "extractionState": "manual",
      "localizations": {
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tempoh akses akaun ini telah tamat — tetapkan tarikh tamat akses yang baharu dahulu"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このアカウントのアクセス期間は終了しています — 先に新しいアクセスの終了日を設定してください"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Periode akses akun ini telah berakhir — tetapkan akhir akses baru lebih dulu"
          }
        }
      }
    },
    "This campaign has not ended — abort it first": {
      "extractionState": "manual",
      "localizations": {
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Kempen ini belum tamat — henti paksanya dahulu"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この配信はまだ終わっていません。先に中止してください"
