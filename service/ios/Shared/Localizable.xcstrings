          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "tersisa {s} dtk"
          }
        }
      }
    },
    "{unit}: sent — its answer could not be read. Refresh to see the AC's state before sending again.": {
      "extractionState": "manual",
      "localizations": {
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "{unit}: dihantar — jawapannya tidak dapat dibaca. Muat semula untuk melihat keadaan AC sebelum menghantar lagi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "{unit}: 送信しましたが、応答を読み取れませんでした。もう一度送る前に、更新してエアコンの状態を確認してください。"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "{unit}: terkirim — jawabannya tidak dapat dibaca. Muat ulang untuk melihat kondisi AC sebelum mengirim lagi."
          }
        }
      }
    },
