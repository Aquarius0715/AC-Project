    "{result}. The AC keeps its confirmed setting; check it and send again.": {
      "extractionState": "manual",
      "localizations": {
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "{result}. AC kekal pada tetapan yang disahkan; semak dan hantar semula."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "{result}。エアコンは確定済みの設定のままです。確認してからもう一度送ってください。"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "{result}. AC tetap pada pengaturan yang dikonfirmasi; periksa lalu kirim lagi."
          }
        }
      }
    },
