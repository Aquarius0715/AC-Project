        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Jendela pekerjaan telah berakhir — minta koordinator Anda menjadwalkan ulang."
          }
        }
      }
    },
    "this AC changed — reload and try again": {
      "extractionState": "manual",
      "localizations": {
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "AC ini telah berubah — muat semula dan cuba lagi"
          }
        },
        "ja": {
