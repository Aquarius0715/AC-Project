        }
      }
    },
    "Your phone reports arriving and leaving your homes and offices, also while the app is closed. Its position is compared with their map pins, and only home or away is kept.": {
      "extractionState": "manual",
      "localizations": {
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Telefon anda melaporkan ketibaan dan keluar dari rumah dan pejabat anda, walaupun aplikasi ditutup. Kedudukannya dibandingkan dengan pin peta, dan hanya di rumah atau keluar disimpan."
          }
        },
        "ja": {
