        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Waktu kunjungan disepakati dengan klien."
          }
        }
      }
    },
    "The work window ended — unsaved input was discarded and the job can no longer be edited. Ask your coordinator.": {
      "extractionState": "manual",
      "localizations": {
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tetingkap kerja telah tamat — input yang belum disimpan dibuang dan kerja tidak lagi boleh diedit. Tanya penyelaras anda."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "作業時間が終了しました — 未保存の入力は破棄され、この作業は編集できなくなりました。担当者に連絡してください。"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Jendela pekerjaan berakhir — masukan yang belum disimpan dibuang dan pekerjaan tidak dapat diubah lagi. Hubungi koordinator Anda."
          }
        }
      }
    },
    "The work window has ended — ask your coordinator to reschedule.": {
      "extractionState": "manual",
      "localizations": {
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tetingkap kerja telah tamat — minta penyelaras anda menjadualkan semula."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "作業時間が終了しました — 担当者に日程の変更を依頼してください。"
