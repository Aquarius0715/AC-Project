    "An HQ account works in the HQ app — sign in there": {
      "extractionState": "manual",
      "localizations": {
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Akaun HQ berfungsi dalam aplikasi HQ — log masuk di sana"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "本部のアカウントは本部アプリで使います — そちらでログインしてください"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Akun HQ bekerja di aplikasi HQ — masuk di sana"
          }
        }
      }
    },
    "An imported unit now has telemetry, jobs or other history — the import can no longer be undone": {
      "extractionState": "manual",
      "localizations": {
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Unit yang diimport kini mempunyai telemetri, kerja atau sejarah lain — import ini tidak boleh dibatalkan lagi"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "取り込んだユニットに計測データや作業などの履歴ができたため、この取り込みは取り消せません"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Unit yang diimpor kini memiliki telemetri, pekerjaan, atau riwayat lain — impor tidak dapat dibatalkan lagi"
          }
        }
      }
    },
    "An MRV report cites this baseline, so it cannot be deleted": {
      "extractionState": "manual",
      "localizations": {
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Laporan MRV merujuk garis dasar ini, jadi tidak boleh dipadam"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "MRV レポートがこのベースラインを参照しているため削除できません"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Laporan MRV merujuk baseline ini, jadi tidak dapat dihapus"
          }
        }
      }
    },
    "An MRV report cites this factor, so it cannot be deleted": {
      "extractionState": "manual",
      "localizations": {
