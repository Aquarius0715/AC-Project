docs/05-document-review/
.DS_Store

# Env files hold local or deployment values and stay out of git and images (container-design.md, IR369); only the
# example is tracked
.env
.env.*
!.env.local.example

# Go build / coverage artifacts (service/*)
service/coverage.out
service/.cover/
service/api/coverage.out
service/api/.cover/
service/api/.test-all/
# the binaries `go build ./cmd/<name>/` (one package) leaves in service/api; three were committed by mistake in 8d3080a0
service/api/billing-api
service/api/devicesim
service/api/energy-api
service/api/equipment-api
service/api/gateway
service/api/identity-api
service/api/iotbridge
service/api/maintenance-api
service/api/migrate
service/api/mockhistory
service/api/ops
service/api/restdoc
service/api/seed
service/api/worker

# Playwright end-to-end runs (service/web/e2e, IR252): signed-in browser state and run output
service/web/e2e/.auth/
service/web/e2e/test-results/
service/web/e2e/playwright-report/
# broker password file stamp (hash of the local keys, docker/mosquitto/passwd.sh)
docker/mosquitto/.passwd.keys

# Python byte code (deploy/test/realm.py, docs/tools)
__pycache__/

# the results of a load run (deploy/load/run.sh): summary, k6 log, samples, settings
load-out/

# the review-loop runner (scripts/review-loop.sh): per-round logs, run output, stop file
.review-loop-logs/
.review-loop-run.out
.review-loop-stop
