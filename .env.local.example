# Copy to .env.local (git-ignored). Local values only — never real secrets.
STRIPE_TEST_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
LOG_LEVEL=debug
# IoT demo broker logins (docker/mosquitto/passwd.sh writes the broker password file from these). Generate each with: openssl rand -hex 24
MQTT_DEVICE_SIM_KEY=
MQTT_IOT_BRIDGE_KEY=
# Real sensor nodes (optional, DEC-86): the IoT bridge subscribes to their broker (it never publishes there) and records
# their readings on the live site, which migrate adds when REAL_MQTT_URL is set (e.g. tcp://broker.example:1883).
REAL_MQTT_URL=
REAL_MQTT_USER=
REAL_MQTT_PASSWORD=
