# Copy to .env.local (git-ignored). Local values only — never real secrets.
# The stripe profile's Stripe CLI (test mode) forwards webhooks with this key (container design §4).
STRIPE_TEST_SECRET_KEY=
# IoT demo broker logins (docker/mosquitto/passwd.sh writes the broker password file from these). Generate each with: openssl rand -hex 24
MQTT_DEVICE_SIM_KEY=
MQTT_IOT_BRIDGE_KEY=
# Real sensor nodes (optional, DEC-86): the IoT bridge subscribes to their broker and records their readings on the live
# site, which migrate adds when REAL_MQTT_URL is set (e.g. tcp://broker.example:1883).
REAL_MQTT_URL=
REAL_MQTT_USER=
REAL_MQTT_PASSWORD=
# 1 lets the bridge send the live unit's power on/off to the command node (node_1 unless REAL_MQTT_COMMAND_NODE names
# another); it switches a real air conditioner (DEC-89). Empty: the live unit's commands fail.
REAL_MQTT_COMMANDS=
# Optional overrides (compose defaults in brackets): the nodes' topic [smarthome/ac/#], the command node [node_1] and
# the local session store and write-limit password of Valkey [local-valkey-only].
# REAL_MQTT_TOPIC=
# REAL_MQTT_COMMAND_NODE=
# VALKEY_PASSWORD=
