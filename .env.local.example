# Copy to .env.local (git-ignored). Local values only — never real secrets.
# The stripe profile's Stripe CLI (test mode) forwards webhooks with this key (container design §4).
STRIPE_TEST_SECRET_KEY=
# Stripe Checkout (DEC-68, IR827): set STRIPE_SECRET_KEY (restricted, test mode) and STRIPE_WEBHOOK_SECRET together, and
# PAYMENT_PROVIDER=stripe for the customer app; leave them empty for the demo payments. For a real test-mode run, set
# STRIPE_API_BASE=https://api.stripe.com (stripe-mock otherwise) and take the webhook secret from the Stripe CLI:
#   docker compose --env-file .env.local --profile stripe run --rm stripe-cli listen --print-secret
# then start the CLI (docker compose --env-file .env.local --profile stripe up -d stripe-cli) to forward the events.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_API_BASE=
PAYMENT_PROVIDER=demo
# IoT demo broker logins (docker/mosquitto/passwd.sh writes the broker password file from these). Generate each with: openssl rand -hex 24
MQTT_DEVICE_SIM_KEY=
MQTT_IOT_BRIDGE_KEY=
# Real sensor nodes (optional, DEC-86): the IoT bridge subscribes to their broker and records their readings on the live
# site, which migrate adds when REAL_MQTT_URL is set (e.g. tcp://broker.example:1883).
REAL_MQTT_URL=
REAL_MQTT_USER=
REAL_MQTT_PASSWORD=
# 1 lets the bridge send a live unit's commands (power, setpoint, mode, fan) to the node of the unit's device (the MQTT
# node ID registered in Admin's devices); they set a real air conditioner (DEC-89, DEC-104). Empty: the live units'
# commands fail.
REAL_MQTT_COMMANDS=
# Optional overrides (compose defaults in brackets): the nodes' topic [smarthome/ac/#] and the local session store and
# write-limit password of Valkey [local-valkey-only].
# REAL_MQTT_TOPIC=
# VALKEY_PASSWORD=
# A deployment others reach sets more (the shared test environment's ~/ac-test/env, written by deploy/test/setup.sh); here
# the compose defaults, this machine's, apply: PUBLISH_ADDR, CUSTOMER_WEB_PORT … ADMIN_WEB_PORT, KEYCLOAK_PORT,
# MAILPIT_PORT, CUSTOMER_WEB_URL … ADMIN_WEB_URL, KEYCLOAK_URL, KEYCLOAK_REALM_FILE, IMAGE_TAG and its own secrets
# (KEYCLOAK_ADMIN_PASSWORD, AC_WEB_CLIENT_SECRET, AC_ADMIN_WEB_CLIENT_SECRET, IDP_ADMIN_CLIENT_SECRET, SESSION_SECRET,
# INTERNAL_API_TOKEN).
